{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doodle Scene",
  "type": "object",
  "required": ["scene_id", "width", "height", "fps", "duration", "elements"],
  "properties": {
    "scene_id": {"type": "string"},
    "width": {"type": "integer"},
    "height": {"type": "integer"},
    "fps": {"type": "integer"},
    "duration": {"type": "number"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "asset": {"type": "string"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "scale": {"type": "number"},
          "animation": {"type": "string"}
        }
      }
    }
  }
}
